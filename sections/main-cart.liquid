{% comment %}
  Section: Main Cart
  File: sections/main-cart.liquid
{% endcomment %}

<section class="cart-main">
  <div class="container">

    <div class="cart-head" data-reveal>
      <span class="eyebrow">Your Order</span>
      <h1 class="cart-title">Shopping Cart</h1>
      <p class="cart-sub">Insurance-covered maternity essentials, ready to ship to your door.</p>
    </div>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate class="cart-form" data-cart-page>
        <div class="cart-layout">

          <div class="cart-lines-wrap">
            <div class="cart-lines-head">
              <span>Product</span>
              <span class="cart-lines-head-qty">Quantity</span>
              <span class="cart-lines-head-total">Total</span>
            </div>

            <ul class="cart-lines" data-cart-page-items>
              {%- for item in cart.items -%}
                <li class="cart-line" data-line="{{ forloop.index }}" data-line-key="{{ item.key }}">
                  <a href="{{ item.url }}" class="cart-line-image">
                    {%- if item.image != blank -%}
                      {{ item.image | image_url: width: 240 | image_tag: alt: item.title, loading: 'lazy' }}
                    {%- endif -%}
                  </a>

                  <div class="cart-line-info">
                    <a href="{{ item.url }}" class="cart-line-title">{{ item.product.title }}</a>
                    {%- unless item.variant.title == 'Default Title' -%}
                      <p class="cart-line-variant">{{ item.variant.title }}</p>
                    {%- endunless -%}
                    <p class="cart-line-unit">{{ item.final_price | money }} each</p>

                    <button type="button" class="cart-line-remove cart-line-remove-mobile" data-cart-remove>
                      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="16" height="16" aria-hidden="true">
                        <path d="M4 7h16M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      Remove
                    </button>
                  </div>

                  <div class="cart-line-qty">
                    <div class="qty-stepper">
                      <button type="button" class="qty-btn" data-qty-decrease aria-label="Decrease quantity">&minus;</button>
                      <input type="number" class="qty-input" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity" data-qty-input>
                      <button type="button" class="qty-btn" data-qty-increase aria-label="Increase quantity">+</button>
                    </div>
                  </div>

                  <div class="cart-line-total">
                    <span>{{ item.final_line_price | money }}</span>
                    <button type="button" class="cart-line-remove" aria-label="Remove item" data-cart-remove>
                      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18">
                        <path d="M4 7h16M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                  </div>
                </li>
              {%- endfor -%}
            </ul>

            <a href="{{ routes.all_products_collection_url }}" class="cart-continue">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" aria-hidden="true">
                <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Continue shopping
            </a>
          </div>

          <aside class="cart-summary" data-reveal data-reveal-delay="100">
            <h2 class="cart-summary-title">Order Summary</h2>

            <div class="cart-summary-row">
              <span>Subtotal</span>
              <strong data-cart-page-subtotal>{{ cart.total_price | money }}</strong>
            </div>
            <div class="cart-summary-row muted">
              <span>Shipping</span>
              <span>Calculated at checkout</span>
            </div>
            <div class="cart-summary-row muted">
              <span>Taxes</span>
              <span>Calculated at checkout</span>
            </div>

            <div class="cart-summary-total">
              <span>Estimated Total</span>
              <strong data-cart-page-total>{{ cart.total_price | money }}</strong>
            </div>

            <button type="submit" name="checkout" class="btn btn-primary cart-summary-checkout">
              Proceed to Checkout
            </button>

            <div class="cart-summary-perks">
              <div class="cart-perk">
                <span class="cart-perk-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="20" height="20">
                    <path d="M3 7h13v8H3zM16 10h3l2 3v2h-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="7" cy="17" r="1.6" stroke="currentColor" stroke-width="1.6"/>
                    <circle cx="17" cy="17" r="1.6" stroke="currentColor" stroke-width="1.6"/>
                  </svg>
                </span>
                <div>
                  <p class="cart-perk-title">Free shipping</p>
                  <p class="cart-perk-sub">On every insurance-covered order</p>
                </div>
              </div>
              <div class="cart-perk">
                <span class="cart-perk-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="20" height="20">
                    <path d="M12 3l8 4v5c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V7l8-4z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                    <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <div>
                  <p class="cart-perk-title">Secure checkout</p>
                  <p class="cart-perk-sub">Encrypted &amp; HIPAA-aware</p>
                </div>
              </div>
            </div>
          </aside>
        </div>
      </form>

    {%- else -%}
      <div class="cart-empty-state" data-reveal>
        <span class="cart-empty-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="64" height="64">
            <path d="M3 4h2.2l2.5 12.2a2 2 0 0 0 2 1.6h8.4a2 2 0 0 0 2-1.5L21.5 8H6.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="10" cy="21" r="1.5" fill="currentColor"/>
            <circle cx="18" cy="21" r="1.5" fill="currentColor"/>
          </svg>
        </span>
        <h2 class="cart-empty-title">Your cart is empty</h2>
        <p class="cart-empty-sub">Looks like you haven&rsquo;t added anything yet. Explore our maternity essentials &mdash; many are 100% covered by insurance.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary">Start Shopping</a>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var form = document.querySelector('[data-cart-page]');
    if (!form || !window.ArdentCart) return;

    function handle(e, action) {
      var li = e.target.closest('.cart-line');
      if (!li) return;
      var line = parseInt(li.getAttribute('data-line'), 10);
      var input = li.querySelector('[data-qty-input]');
      var qty;

      if (action === 'remove') qty = 0;
      if (action === 'inc') qty = parseInt(input.value, 10) + 1;
      if (action === 'dec') qty = Math.max(0, parseInt(input.value, 10) - 1);
      if (action === 'set') qty = Math.max(0, parseInt(input.value, 10) || 0);

      window.ArdentCart.change(line, qty).then(function () {
        // Full reload to redraw the page-level cart with correct line indices
        window.location.reload();
      });
    }

    form.addEventListener('click', function (e) {
      if (e.target.closest('[data-cart-remove]')) { e.preventDefault(); handle(e, 'remove'); }
      else if (e.target.closest('[data-qty-increase]')) { e.preventDefault(); handle(e, 'inc'); }
      else if (e.target.closest('[data-qty-decrease]')) { e.preventDefault(); handle(e, 'dec'); }
    });

    form.addEventListener('change', function (e) {
      if (e.target.matches('[data-qty-input]')) handle(e, 'set');
    });
  })();
</script>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "settings": []
}
{% endschema %}
