{% comment %}
  Section: Insurance Hassle (multi-step style form, product page)
  File: sections/insurance-hassle.liquid
  Figma: "Insurance Hassle / Handled in 24 Hours"

  Uses Shopify's built-in {% form 'contact' %} so submissions go to the
  store's contact email. Each form field is a dynamic block so merchants
  can add, remove, reorder and rename inputs from the theme editor.

  Note: Shopify's contact form does not persist file uploads; the field is
  rendered for the customer's benefit but the file is not retained. Swap to
  a custom action (Klaviyo / Formspree / etc.) if uploads must be stored.
{% endcomment %}

{%- liquid
  assign pad_top = section.settings.padding_top | default: 112
  assign pad_bottom = section.settings.padding_bottom | default: 112
  assign pad_x = section.settings.padding_x | default: 64
  assign margin_top = section.settings.margin_top | default: 0
  assign margin_bottom = section.settings.margin_bottom | default: 0
  assign uid = section.id | replace: '_', '' | downcase
  assign form_id = 'ins-hassle-form-' | append: uid
-%}

<section class="ins-hassle-section" style="
  --ih-bg: {{ section.settings.background_color | default: '#ffffff' }};
  --ih-heading-color: {{ section.settings.heading_color | default: '#000000' }};
  --ih-desc-color: {{ section.settings.description_color | default: '#000000' }};
  --ih-eyebrow-color: {{ section.settings.eyebrow_color | default: '#000000' }};
  --ih-card-bg: {{ section.settings.card_bg | default: '#ffffff' }};
  --ih-card-border: {{ section.settings.card_border | default: '#000000' }};
  --ih-input-text: {{ section.settings.input_text | default: '#000000' }};
  --ih-input-placeholder: {{ section.settings.input_placeholder | default: 'rgba(0,0,0,0.6)' }};
  --ih-button-bg: {{ section.settings.button_bg | default: '#000000' }};
  --ih-button-text: {{ section.settings.button_text_color | default: '#ffffff' }};
  --ih-button-border: {{ section.settings.button_border | default: '#000000' }};
  --ih-footnote-color: {{ section.settings.footnote_color | default: '#5a5a5a' }};
  background: var(--ih-bg, #fff);
  padding: {{ pad_top }}px {{ pad_x }}px {{ pad_bottom }}px;
  margin: {{ margin_top }}px 0 {{ margin_bottom }}px;
">
  <div class="ins-hassle-container">

    <div class="ins-hassle-intro">
      {%- if section.settings.show_heading and section.settings.heading != blank -%}
        <h2 class="ins-hassle-heading" data-reveal>{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.show_description and section.settings.description != blank -%}
        <div class="ins-hassle-desc" data-reveal data-reveal-delay="100">
          {{ section.settings.description }}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_eyebrow and section.settings.eyebrow != blank -%}
      <p class="ins-hassle-eyebrow" data-reveal data-reveal-delay="160">
        {{ section.settings.eyebrow }}
      </p>
    {%- endif -%}

    {%- form 'contact', class: 'ins-hassle-form', enctype: 'multipart/form-data', id: form_id -%}

      {%- if form.posted_successfully? -%}
        <div class="ins-hassle-success" role="status">
          {{ section.settings.success_message | default: "Thanks — we'll be in touch within 24 hours." }}
        </div>
      {%- elsif form.errors -%}
        <div class="ins-hassle-error" role="alert">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <input type="hidden" name="contact[Form type]" value="{{ section.settings.form_type | default: 'Insurance Hassle' | escape }}">

      {%- if section.blocks.size > 0 -%}
        <div class="ins-hassle-grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'field' -%}
              {%- liquid
                assign d = forloop.index0 | times: 60
                assign idx = forloop.index
                assign field_id = 'ih-' | append: uid | append: '-' | append: block.id
                assign raw_name = block.settings.field_name | default: block.settings.label | default: 'Field'
                assign field_name = 'contact[' | append: raw_name | append: ']'
                assign req = block.settings.required
                assign type = block.settings.field_type | default: 'text'
                assign placeholder = block.settings.placeholder | default: block.settings.label
                assign half = block.settings.half_width
              -%}

              <div class="ins-hassle-card{% if half %} ins-hassle-card--half{% endif %}" data-reveal data-reveal-delay="{{ d }}" {{ block.shopify_attributes }}>
                {%- if block.settings.show_label and block.settings.label != blank -%}
                  <label class="ins-hassle-card-label" for="{{ field_id }}">
                    {%- if block.settings.show_number -%}
                      <span class="ins-hassle-card-num">{{ idx }}.</span>
                    {%- endif -%}
                    <span class="ins-hassle-card-text">{{ block.settings.label }}</span>
                    {%- if req -%}<span class="ins-hassle-card-req" aria-hidden="true">*</span>{%- endif -%}
                  </label>
                {%- endif -%}

                {%- case type -%}
                  {%- when 'textarea' -%}
                    <textarea
                      id="{{ field_id }}"
                      name="{{ field_name }}"
                      class="ins-hassle-input ins-hassle-textarea"
                      placeholder="{{ placeholder | escape }}"
                      rows="{{ block.settings.textarea_rows | default: 4 }}"
                      {% if req %}required{% endif %}
                    ></textarea>

                  {%- when 'file' -%}
                    <div class="ins-hassle-file">
                      <input
                        type="file"
                        id="{{ field_id }}"
                        name="{{ field_name }}"
                        accept="{{ block.settings.file_accept | default: 'image/*,.pdf' }}"
                        {% if req %}required{% endif %}
                      >
                      <label for="{{ field_id }}" class="ins-hassle-file-label">
                        <span class="ins-hassle-file-text">{{ placeholder | default: 'Choose file' }}</span>
                        <span class="ins-hassle-file-btn">{{ block.settings.file_button_text | default: 'Browse' }}</span>
                      </label>
                    </div>

                  {%- when 'checkbox' -%}
                    <label class="ins-hassle-checkbox" for="{{ field_id }}">
                      <input
                        type="checkbox"
                        id="{{ field_id }}"
                        name="{{ field_name }}"
                        value="Yes"
                        {% if req %}required{% endif %}
                      >
                      <span class="ins-hassle-checkbox-text">{{ placeholder | default: block.settings.label }}</span>
                    </label>

                  {%- when 'select' -%}
                    {%- assign options = block.settings.options | default: '' | split: ',' -%}
                    <select
                      id="{{ field_id }}"
                      name="{{ field_name }}"
                      class="ins-hassle-input ins-hassle-select"
                      {% if req %}required{% endif %}
                    >
                      {%- if placeholder != blank -%}
                        <option value="" disabled selected>{{ placeholder }}</option>
                      {%- endif -%}
                      {%- for opt in options -%}
                        {%- assign opt_clean = opt | strip -%}
                        {%- if opt_clean != blank -%}
                          <option value="{{ opt_clean | escape }}">{{ opt_clean }}</option>
                        {%- endif -%}
                      {%- endfor -%}
                    </select>

                  {%- else -%}
                    <input
                      type="{{ type }}"
                      id="{{ field_id }}"
                      name="{% if type == 'email' %}contact[email]{% elsif type == 'tel' %}contact[phone]{% else %}{{ field_name }}{% endif %}"
                      class="ins-hassle-input"
                      placeholder="{{ placeholder | escape }}"
                      {% if block.settings.autocomplete != blank %}autocomplete="{{ block.settings.autocomplete }}"{% endif %}
                      {% if req %}required{% endif %}
                    >
                {%- endcase -%}

                {%- if block.settings.help_text != blank -%}
                  <p class="ins-hassle-card-help">{{ block.settings.help_text }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="ins-hassle-submit-wrap">
        <button type="submit" class="ins-hassle-submit">
          {{ section.settings.button_text | default: 'Submit & Get Started' }}
        </button>
      </div>

    {%- endform -%}

    {%- if section.settings.show_footnote and section.settings.footnote != blank -%}
      <div class="ins-hassle-footnote" data-reveal data-reveal-delay="200">
        {{ section.settings.footnote }}
      </div>
    {%- endif -%}

  </div>
</section>

<script>
  (function () {
    var section = document.getElementById('ins-hassle-form-{{ uid }}');
    if (!section) return;
    var files = section.querySelectorAll('.ins-hassle-file input[type="file"]');
    files.forEach(function (input) {
      var label = input.nextElementSibling;
      if (!label) return;
      var text = label.querySelector('.ins-hassle-file-text');
      var original = text ? text.textContent : '';
      input.addEventListener('change', function () {
        if (input.files && input.files.length) {
          text.textContent = input.files[0].name;
          label.classList.add('has-file');
        } else {
          text.textContent = original;
          label.classList.remove('has-file');
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Insurance Hassle",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Intro" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Your Insurance Hassle, Handled in 24 Hours</p>" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Stop wasting weeks on phone calls. Submit your prescription once — we'll handle insurance, prior authorization, and shipping while you focus on what matters.</p>" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How It Works" },

    { "type": "header", "content": "Submit & messages" },
    { "type": "text", "id": "button_text", "label": "Submit button text", "default": "Submit & Get Started" },
    { "type": "text", "id": "form_type", "label": "Form type (hidden tag in email)", "default": "Insurance Hassle" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thanks — we'll be in touch within 24 hours." },
    { "type": "richtext", "id": "footnote", "label": "Footnote", "default": "<p>Your information is secure and only used to verify your insurance benefits.</p>" },

    { "type": "header", "content": "Show / hide elements" },
    { "type": "checkbox", "id": "show_heading", "label": "Show heading", "default": true },
    { "type": "checkbox", "id": "show_description", "label": "Show description", "default": true },
    { "type": "checkbox", "id": "show_eyebrow", "label": "Show eyebrow", "default": true },
    { "type": "checkbox", "id": "show_footnote", "label": "Show footnote", "default": true },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 112 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 112 },
    { "type": "range", "id": "padding_x", "label": "Padding left / right", "min": 0, "max": 96, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },

    { "type": "header", "content": "Section colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#000000" },
    { "type": "color", "id": "description_color", "label": "Description", "default": "#000000" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow", "default": "#000000" },
    { "type": "color", "id": "footnote_color", "label": "Footnote", "default": "#5a5a5a" },

    { "type": "header", "content": "Field card colors" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "card_border", "label": "Card border", "default": "#000000" },
    { "type": "color", "id": "input_text", "label": "Input text", "default": "#000000" },
    { "type": "color", "id": "input_placeholder", "label": "Placeholder text", "default": "#999999" },

    { "type": "header", "content": "Submit button colors" },
    { "type": "color", "id": "button_bg", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "button_text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "button_border", "label": "Border", "default": "#000000" }
  ],
  "blocks": [
    {
      "type": "field",
      "name": "Form field",
      "settings": [
        {
          "type": "select",
          "id": "field_type",
          "label": "Field type",
          "default": "text",
          "options": [
            { "value": "text",     "label": "Text" },
            { "value": "email",    "label": "Email" },
            { "value": "tel",      "label": "Phone" },
            { "value": "number",   "label": "Number" },
            { "value": "url",      "label": "URL" },
            { "value": "date",     "label": "Date" },
            { "value": "textarea", "label": "Multi-line text" },
            { "value": "select",   "label": "Dropdown" },
            { "value": "file",     "label": "File upload" },
            { "value": "checkbox", "label": "Checkbox" }
          ]
        },
        { "type": "text",     "id": "label",       "label": "Card label",       "default": "Your Information" },
        { "type": "text",     "id": "placeholder", "label": "Placeholder",      "default": "Type here…" },
        { "type": "text",     "id": "field_name",  "label": "Submission field name", "info": "How this field appears in the email (e.g. 'First and Last Name'). Leave blank to use the card label." },
        { "type": "text",     "id": "autocomplete","label": "Autocomplete attribute", "info": "e.g. name, email, tel, street-address" },
        { "type": "checkbox", "id": "required",    "label": "Required",         "default": true },
        { "type": "checkbox", "id": "show_label",  "label": "Show card label",  "default": true },
        { "type": "checkbox", "id": "show_number", "label": "Show step number", "default": true },
        { "type": "checkbox", "id": "half_width",  "label": "Half width (desktop)", "default": false },
        { "type": "textarea", "id": "help_text",   "label": "Help text (below field)" },

        { "type": "header", "content": "Dropdown options (Dropdown type only)" },
        { "type": "textarea", "id": "options", "label": "Options (comma-separated)", "info": "Example: Aetna, Blue Cross, Cigna, United Healthcare" },

        { "type": "header", "content": "Textarea (Multi-line only)" },
        { "type": "range", "id": "textarea_rows", "label": "Rows", "min": 2, "max": 12, "step": 1, "default": 4 },

        { "type": "header", "content": "File upload (File type only)" },
        { "type": "text", "id": "file_accept", "label": "Allowed file types", "default": "image/*,.pdf" },
        { "type": "text", "id": "file_button_text", "label": "Browse button text", "default": "Browse" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Insurance Hassle",
      "blocks": [
        { "type": "field", "settings": { "field_type": "text",  "label": "Your Information",     "placeholder": "Your First and Last Name*",     "field_name": "Full name",          "autocomplete": "name",            "required": true } },
        { "type": "field", "settings": { "field_type": "tel",   "label": "Phone Number",         "placeholder": "Your Phone Number*",            "field_name": "Phone",              "autocomplete": "tel",             "required": true } },
        { "type": "field", "settings": { "field_type": "email", "label": "Email Address",        "placeholder": "Your Email Address*",           "field_name": "Email",              "autocomplete": "email",           "required": true } },
        { "type": "field", "settings": { "field_type": "text",  "label": "Shipping Address",     "placeholder": "Street, City, State, ZIP*",     "field_name": "Shipping address",   "autocomplete": "street-address",  "required": true } },
        { "type": "field", "settings": { "field_type": "text",  "label": "Insurance Provider",   "placeholder": "Insurance plan name*",          "field_name": "Insurance provider", "required": true } },
        { "type": "field", "settings": { "field_type": "text",  "label": "Insurance Member ID",  "placeholder": "Member ID number*",             "field_name": "Member ID",          "required": true } },
        { "type": "field", "settings": { "field_type": "text",  "label": "Doctor's Information", "placeholder": "Doctor's Name & Phone Number",  "field_name": "Doctor details",     "required": false } },
        { "type": "field", "settings": { "field_type": "date",  "label": "Estimated Due Date",   "placeholder": "Estimated Due Date",            "field_name": "Due date",           "required": false } },
        { "type": "field", "settings": { "field_type": "file",  "label": "Prescription Upload",  "placeholder": "Upload your prescription",      "field_name": "Prescription",       "required": false, "file_accept": "image/*,.pdf" } },
        { "type": "field", "settings": { "field_type": "textarea", "label": "Special Requests / Notes", "placeholder": "Anything else we should know? (Optional)", "field_name": "Notes", "required": false, "textarea_rows": 4 } }
      ]
    }
  ]
}
{% endschema %}
