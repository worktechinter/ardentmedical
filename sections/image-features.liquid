{% comment %}
  Section: Image Features
  File: sections/image-features.liquid

  Two-column layout: a large product image on one side, a stacked list
  of feature rows on the other. Each feature row has an icon, a heading,
  a short description, and an optional "Details" arrow link.

  Image side can be swapped via "Image position" (left / right).
  All copy, icons, colors, and toggles are merchant-controlled.
{% endcomment %}

{%- liquid
  assign pad_top = section.settings.padding_top | default: 112
  assign pad_bottom = section.settings.padding_bottom | default: 112
  assign pad_x = section.settings.padding_x | default: 64
  assign margin_top = section.settings.margin_top | default: 0
  assign margin_bottom = section.settings.margin_bottom | default: 0
  assign image_alt = section.settings.heading | default: '' | strip_html | strip
-%}

<section class="if-section" style="
  --if-bg: {{ section.settings.background_color | default: '#ffffff' }};
  --if-eyebrow-color: {{ section.settings.eyebrow_color | default: '#000000' }};
  --if-heading-color: {{ section.settings.heading_color | default: '#000000' }};
  --if-text-color: {{ section.settings.text_color | default: '#000000' }};
  --if-feature-heading-color: {{ section.settings.feature_heading_color | default: '#000000' }};
  --if-feature-text-color: {{ section.settings.feature_text_color | default: '#000000' }};
  --if-icon-color: {{ section.settings.icon_color | default: '#000000' }};
  --if-link-color: {{ section.settings.link_color | default: '#000000' }};
  --if-image-bg: {{ section.settings.image_bg | default: '#e6e6e6' }};
  background: var(--if-bg, #fff);
  padding: {{ pad_top }}px {{ pad_x }}px {{ pad_bottom }}px;
  margin: {{ margin_top }}px 0 {{ margin_bottom }}px;
">
  <div class="if-container">

    {%- if section.settings.show_eyebrow or section.settings.show_heading or section.settings.show_description -%}
      {%- assign has_top = false -%}
      {%- if section.settings.show_eyebrow and section.settings.eyebrow != blank -%}{%- assign has_top = true -%}{%- endif -%}
      {%- if section.settings.show_heading and section.settings.heading != blank -%}{%- assign has_top = true -%}{%- endif -%}
      {%- if section.settings.show_description and section.settings.description != blank -%}{%- assign has_top = true -%}{%- endif -%}
      {%- if has_top -%}
        <div class="if-top">
          {%- if section.settings.show_eyebrow and section.settings.eyebrow != blank -%}
            <p class="if-eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.show_heading and section.settings.heading != blank -%}
            <h2 class="if-heading" data-reveal data-reveal-delay="80">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.show_description and section.settings.description != blank -%}
            <div class="if-desc" data-reveal data-reveal-delay="160">{{ section.settings.description }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    <div class="if-grid if-image-{{ section.settings.image_position | default: 'left' }}">

      {%- if section.settings.show_image -%}
        <div class="if-image" data-reveal>
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1200 | image_tag:
              alt: image_alt,
              loading: 'lazy',
              class: 'if-image-img',
              widths: '400, 600, 800, 1000, 1200',
              sizes: '(min-width: 1024px) 50vw, 100vw'
            }}
          {%- else -%}
            <div class="if-image-placeholder" aria-hidden="true">
              <svg viewBox="0 0 80 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="6" y="6" width="68" height="52" rx="3" stroke="currentColor" stroke-width="2"/>
                <circle cx="28" cy="26" r="6" stroke="currentColor" stroke-width="2"/>
                <path d="M6 50 L28 32 L46 46 L60 36 L74 50" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="if-features">
        {%- for block in section.blocks -%}
          {%- if block.type == 'feature' -%}
            {%- assign d = forloop.index0 | times: 120 | plus: 80 -%}
            <article class="if-feature" data-reveal data-reveal-delay="{{ d }}" {{ block.shopify_attributes }}>

              <div class="if-feature-icon" aria-hidden="true">
                {%- if block.settings.icon != blank -%}
                  {{ block.settings.icon | image_url: width: 96 | image_tag: alt: '', loading: 'lazy' }}
                {%- else -%}
                  <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="5" y="6" width="22" height="18" rx="2" stroke="currentColor" stroke-width="2"/>
                    <circle cx="12" cy="14" r="3" stroke="currentColor" stroke-width="2"/>
                    <path d="M5 21 L12 16 L18 20 L22 17 L27 21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- endif -%}
              </div>

              <div class="if-feature-content">
                {%- if block.settings.heading != blank -%}
                  <h3 class="if-feature-heading">{{ block.settings.heading }}</h3>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <p class="if-feature-desc">{{ block.settings.description }}</p>
                {%- endif -%}
                {%- if block.settings.link_text != blank -%}
                  <a href="{{ block.settings.link | default: '#' }}" class="if-feature-link">
                    <span>{{ block.settings.link_text }}</span>
                    <svg width="7" height="12" viewBox="0 0 7 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M0.877 0.5C0.978 0.5 1.055 0.53 1.133 0.608L6.077 5.553C6.131 5.607 6.156 5.649 6.168 5.677V5.678C6.183 5.713 6.191 5.753 6.191 5.802C6.191 5.85 6.183 5.89 6.168 5.926V5.927C6.156 5.955 6.131 5.997 6.077 6.051L1.108 11.02C1.031 11.097 0.963 11.119 0.883 11.116C0.789 11.113 0.708 11.081 0.622 10.995C0.544 10.917 0.513 10.84 0.513 10.739C0.513 10.638 0.544 10.561 0.622 10.483L5.304 5.802L0.597 1.095C0.519 1.017 0.497 0.951 0.5 0.87C0.503 0.776 0.536 0.694 0.622 0.608C0.7 0.531 0.776 0.5 0.877 0.5Z" fill="currentColor" stroke="currentColor"/>
                    </svg>
                  </a>
                {%- endif -%}
              </div>

            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image Features",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Intro (optional)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "richtext", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "description", "label": "Description" },

    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },

    { "type": "header", "content": "Show / hide elements" },
    { "type": "checkbox", "id": "show_eyebrow", "label": "Show eyebrow", "default": false },
    { "type": "checkbox", "id": "show_heading", "label": "Show heading", "default": false },
    { "type": "checkbox", "id": "show_description", "label": "Show description", "default": false },
    { "type": "checkbox", "id": "show_image", "label": "Show image", "default": true },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 112 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 112 },
    { "type": "range", "id": "padding_x", "label": "Padding left / right", "min": 0, "max": 96, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },

    { "type": "header", "content": "Section colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow", "default": "#000000" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Description", "default": "#000000" },
    { "type": "color", "id": "image_bg", "label": "Image placeholder background", "default": "#e6e6e6" },

    { "type": "header", "content": "Feature colors" },
    { "type": "color", "id": "icon_color", "label": "Icon (fallback SVG)", "default": "#000000" },
    { "type": "color", "id": "feature_heading_color", "label": "Feature heading", "default": "#000000" },
    { "type": "color", "id": "feature_text_color", "label": "Feature description", "default": "#000000" },
    { "type": "color", "id": "link_color", "label": "Details link", "default": "#000000" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon (optional)" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Feature heading" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Short description of this feature." },
        { "type": "text", "id": "link_text", "label": "Link text", "default": "Details" },
        { "type": "url", "id": "link", "label": "Link URL" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Image Features",
      "blocks": [
        { "type": "feature", "settings": { "heading": "Quiet operation",  "description": "Runs at a low volume so you can pump at work, home, or anywhere without drawing attention.", "link_text": "Details" } },
        { "type": "feature", "settings": { "heading": "Durable design",   "description": "Built to handle daily use without losing power or breaking down. This pump is made to last through every stage.", "link_text": "Details" } },
        { "type": "feature", "settings": { "heading": "Easy to use",      "description": "Simple controls and straightforward assembly mean you spend less time figuring it out and more time with your baby.", "link_text": "Details" } }
      ]
    }
  ]
}
{% endschema %}
