{% comment %}
  Snippet: insurance-badge
  Renders the pink insurance badge as an absolute overlay on a product image.

  Required:
    product:    a product object

  Optional:
    icon:       image object (theme setting); falls back to settings.insurance_badge_icon if available
    size:       "sm" for compact (collection cards), default is regular (PDP)
{% endcomment %}

{%- if product.metafields.custom.insurance_badge != blank -%}
  {%- assign badge_icon = icon | default: settings.insurance_badge_icon -%}
  {%- if badge_icon != blank -%}
    <div class="ins-badge ins-badge--{{ size | default: 'md' }}" aria-label="{{ product.metafields.custom.insurance_badge | escape }}">
      {{ badge_icon | image_url: width: 240 | image_tag: alt: product.metafields.custom.insurance_badge, loading: 'lazy', class: 'ins-badge-img' }}
    </div>
  {%- endif -%}
{%- endif -%}
