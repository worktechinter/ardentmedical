{% comment %}
  Snippet: Cart Drawer + Sticky Cart Button
  File: snippets/cart-drawer.liquid
  Rendered once globally from layout/theme.liquid.
{% endcomment %}

<button
  type="button"
  class="cart-fab{% if cart.item_count > 0 %} has-items{% endif %}"
  aria-label="Open cart"
  aria-controls="CartDrawer"
  aria-expanded="false"
  data-cart-open
>
  <span class="cart-fab-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M3 4h2.2l2.5 12.2a2 2 0 0 0 2 1.6h8.4a2 2 0 0 0 2-1.5L21.5 8H6.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="10" cy="21" r="1.5" fill="currentColor"/>
      <circle cx="18" cy="21" r="1.5" fill="currentColor"/>
    </svg>
  </span>
  <span class="cart-fab-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
</button>

<div class="cart-drawer-backdrop" data-cart-backdrop hidden></div>

<aside
  id="CartDrawer"
  class="cart-drawer"
  aria-hidden="true"
  aria-label="Shopping cart"
  role="dialog"
>
  <header class="cart-drawer-header">
    <h2 class="cart-drawer-title">Your Cart</h2>
    <button type="button" class="cart-drawer-close" aria-label="Close cart" data-cart-close>
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="22" height="22">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
    </button>
  </header>

  <div class="cart-drawer-body" data-cart-body>
    {%- if cart.item_count > 0 -%}
      <ul class="cart-drawer-items" data-cart-items>
        {%- for item in cart.items -%}
          <li class="cart-drawer-item" data-line-key="{{ item.key }}" data-line="{{ forloop.index }}">
            <a href="{{ item.url }}" class="cart-drawer-item-image">
              {%- if item.image != blank -%}
                {{ item.image | image_url: width: 200 | image_tag: alt: item.title, loading: 'lazy' }}
              {%- endif -%}
            </a>
            <div class="cart-drawer-item-info">
              <a href="{{ item.url }}" class="cart-drawer-item-title">{{ item.product.title }}</a>
              {%- unless item.variant.title == 'Default Title' -%}
                <p class="cart-drawer-item-variant">{{ item.variant.title }}</p>
              {%- endunless -%}
              <p class="cart-drawer-item-price">{{ item.final_line_price | money }}</p>
              <div class="qty-stepper">
                <button type="button" class="qty-btn" data-qty-decrease aria-label="Decrease quantity">&minus;</button>
                <input
                  type="number"
                  class="qty-input"
                  value="{{ item.quantity }}"
                  min="0"
                  aria-label="Quantity"
                  data-qty-input
                >
                <button type="button" class="qty-btn" data-qty-increase aria-label="Increase quantity">+</button>
              </div>
            </div>
            <button type="button" class="cart-drawer-item-remove" aria-label="Remove item" data-cart-remove>
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18">
                <path d="M4 7h16M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <div class="cart-drawer-empty" data-cart-empty>
        <span class="cart-drawer-empty-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="56" height="56">
            <path d="M3 4h2.2l2.5 12.2a2 2 0 0 0 2 1.6h8.4a2 2 0 0 0 2-1.5L21.5 8H6.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <p class="cart-drawer-empty-title">Your cart is empty</p>
        <p class="cart-drawer-empty-sub">Browse our maternity essentials to get started.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary" data-cart-close>Continue shopping</a>
      </div>
    {%- endif -%}
  </div>

  <footer class="cart-drawer-footer" data-cart-footer{% if cart.item_count == 0 %} hidden{% endif %}>
    <div class="cart-drawer-subtotal">
      <span>Subtotal</span>
      <strong data-cart-subtotal>{{ cart.total_price | money }}</strong>
    </div>
    <p class="cart-drawer-note">Shipping &amp; taxes calculated at checkout.</p>
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      <button type="submit" name="checkout" class="btn btn-primary cart-drawer-checkout">Checkout</button>
    </form>
    <a href="{{ routes.cart_url }}" class="cart-drawer-view-cart">View full cart</a>
  </footer>
</aside>

<script>
  (function () {
    var drawer = document.getElementById('CartDrawer');
    var backdrop = document.querySelector('[data-cart-backdrop]');
    var fab = document.querySelector('.cart-fab');
    if (!drawer || !backdrop || !fab) return;

    var moneyFormat = {{ shop.money_format | json }};

    function formatMoney(cents) {
      var value = (cents / 100);
      // Simple USD-style fallback; replace symbol from money_format if present
      var symbolMatch = String(moneyFormat).match(/[^\d\s\{\}\$]*\$|[^\d\s\{\}]+/);
      var symbol = '$';
      if (moneyFormat && moneyFormat.indexOf('$') !== -1) symbol = '$';
      return symbol + value.toFixed(2);
    }

    function openDrawer() {
      backdrop.hidden = false;
      requestAnimationFrame(function () {
        drawer.classList.add('is-open');
        backdrop.classList.add('is-visible');
      });
      drawer.setAttribute('aria-hidden', 'false');
      fab.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      drawer.classList.remove('is-open');
      backdrop.classList.remove('is-visible');
      drawer.setAttribute('aria-hidden', 'true');
      fab.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      setTimeout(function () { backdrop.hidden = true; }, 280);
    }

    fab.addEventListener('click', openDrawer);
    backdrop.addEventListener('click', closeDrawer);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && drawer.classList.contains('is-open')) closeDrawer();
    });
    drawer.addEventListener('click', function (e) {
      if (e.target.closest('[data-cart-close]')) closeDrawer();
    });

    function updateBadge(count) {
      var badge = fab.querySelector('[data-cart-count]');
      if (!badge) return;
      badge.textContent = count;
      if (count > 0) {
        badge.hidden = false;
        fab.classList.add('has-items');
      } else {
        badge.hidden = true;
        fab.classList.remove('has-items');
      }
    }

    function renderEmpty() {
      var body = drawer.querySelector('[data-cart-body]');
      var footer = drawer.querySelector('[data-cart-footer]');
      if (footer) footer.hidden = true;
      if (!body) return;
      body.innerHTML =
        '<div class="cart-drawer-empty" data-cart-empty>' +
        '<span class="cart-drawer-empty-icon" aria-hidden="true">' +
        '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="56" height="56">' +
        '<path d="M3 4h2.2l2.5 12.2a2 2 0 0 0 2 1.6h8.4a2 2 0 0 0 2-1.5L21.5 8H6.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>' +
        '</svg></span>' +
        '<p class="cart-drawer-empty-title">Your cart is empty</p>' +
        '<p class="cart-drawer-empty-sub">Browse our maternity essentials to get started.</p>' +
        '<a href="{{ routes.all_products_collection_url }}" class="btn btn-primary" data-cart-close>Continue shopping</a>' +
        '</div>';
    }

    function renderItems(cart) {
      var body = drawer.querySelector('[data-cart-body]');
      var footer = drawer.querySelector('[data-cart-footer]');
      if (!body) return;

      if (!cart.items || cart.items.length === 0) {
        renderEmpty();
        return;
      }

      var html = '<ul class="cart-drawer-items" data-cart-items>';
      cart.items.forEach(function (item, idx) {
        var lineIndex = idx + 1;
        var variant = (item.variant_title && item.variant_title !== 'Default Title')
          ? '<p class="cart-drawer-item-variant">' + item.variant_title + '</p>' : '';
        var img = item.image
          ? '<img src="' + item.image + '" alt="' + (item.product_title || '') + '" loading="lazy">' : '';
        html += '<li class="cart-drawer-item" data-line-key="' + item.key + '" data-line="' + lineIndex + '">' +
          '<a href="' + item.url + '" class="cart-drawer-item-image">' + img + '</a>' +
          '<div class="cart-drawer-item-info">' +
          '<a href="' + item.url + '" class="cart-drawer-item-title">' + item.product_title + '</a>' +
          variant +
          '<p class="cart-drawer-item-price">' + formatMoney(item.final_line_price) + '</p>' +
          '<div class="qty-stepper">' +
          '<button type="button" class="qty-btn" data-qty-decrease aria-label="Decrease quantity">&minus;</button>' +
          '<input type="number" class="qty-input" value="' + item.quantity + '" min="0" aria-label="Quantity" data-qty-input>' +
          '<button type="button" class="qty-btn" data-qty-increase aria-label="Increase quantity">+</button>' +
          '</div>' +
          '</div>' +
          '<button type="button" class="cart-drawer-item-remove" aria-label="Remove item" data-cart-remove>' +
          '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18">' +
          '<path d="M4 7h16M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>' +
          '</svg></button>' +
          '</li>';
      });
      html += '</ul>';
      body.innerHTML = html;

      if (footer) {
        footer.hidden = false;
        var sub = footer.querySelector('[data-cart-subtotal]');
        if (sub) sub.textContent = formatMoney(cart.total_price);
      }
    }

    function refreshCart(opts) {
      opts = opts || {};
      return fetch('{{ routes.cart_url }}.js', { headers: { 'Accept': 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (cart) {
          updateBadge(cart.item_count);
          renderItems(cart);
          if (opts.open) openDrawer();
          // Notify any page-level cart (main-cart) to refresh its DOM
          document.dispatchEvent(new CustomEvent('cart:updated', { detail: cart }));
          return cart;
        });
    }

    function changeLine(line, quantity) {
      return fetch('{{ routes.cart_change_url }}.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ line: line, quantity: quantity })
      }).then(function (r) { return r.json(); });
    }

    drawer.addEventListener('click', function (e) {
      var item = e.target.closest('.cart-drawer-item');
      if (!item) return;
      var line = parseInt(item.getAttribute('data-line'), 10);
      var input = item.querySelector('[data-qty-input]');

      if (e.target.closest('[data-cart-remove]')) {
        e.preventDefault();
        changeLine(line, 0).then(function () { refreshCart(); });
        return;
      }
      if (e.target.closest('[data-qty-decrease]')) {
        e.preventDefault();
        var dec = Math.max(0, parseInt(input.value, 10) - 1);
        changeLine(line, dec).then(function () { refreshCart(); });
      }
      if (e.target.closest('[data-qty-increase]')) {
        e.preventDefault();
        var inc = parseInt(input.value, 10) + 1;
        changeLine(line, inc).then(function () { refreshCart(); });
      }
    });

    drawer.addEventListener('change', function (e) {
      if (!e.target.matches('[data-qty-input]')) return;
      var item = e.target.closest('.cart-drawer-item');
      var line = parseInt(item.getAttribute('data-line'), 10);
      var qty = Math.max(0, parseInt(e.target.value, 10) || 0);
      changeLine(line, qty).then(function () { refreshCart(); });
    });

    // Intercept product add-to-cart forms to open the drawer with the new item
    document.addEventListener('submit', function (e) {
      var form = e.target.closest('form[action$="/cart/add"], form[action*="/cart/add"]');
      if (!form) return;
      e.preventDefault();
      var data = new FormData(form);
      var submitBtn = form.querySelector('[type="submit"]');
      if (submitBtn) submitBtn.disabled = true;
      fetch('{{ routes.cart_add_url }}.js', {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: data
      })
        .then(function (r) { return r.json(); })
        .then(function () { return refreshCart({ open: true }); })
        .catch(function () { form.submit(); })
        .finally(function () { if (submitBtn) submitBtn.disabled = false; });
    });

    // Expose for other scripts (e.g. main-cart page)
    window.ArdentCart = {
      open: openDrawer,
      close: closeDrawer,
      refresh: refreshCart,
      change: changeLine
    };
  })();
</script>
